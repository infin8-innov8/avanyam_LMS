# avanyam_terra (VM1) — local development environment.
#
# GITIGNORED counterpart: .env      NEVER COMMIT .env — it holds live credentials.
# In production use SOPS or a secret manager (architecture.md §12.4, tasks.md P0.7).
#
# Copy to .env and fill in every blank:
#     cp .env.example .env && chmod 600 .env
#
# Credentials currently exposed in a chat transcript and therefore DISCLOSED —
# rotate the database and S3 values before this reaches anyone else (memory.md D21).

# ── Django ───────────────────────────────────────────────────────────────────
# P0.2 moves settings to a config/settings/{base,dev,prod}.py split. Until then
# the only settings module that exists is the startproject one, so this value
# must stay as-is or `manage.py` cannot import it.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Primary database — VM2 (aero) ────────────────────────────────────────────
# avanyam_app is DML-only: no CREATE/DROP/TRUNCATE, no BYPASSRLS, not superuser.
# Migrations use a SEPARATE credential (DB_MIGRATE_*) held only by the one-shot
# migration container, never by the running web process (architecture.md §14.3).
DB_NAME=avanyam
DB_USER=avanyam_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

DB_MIGRATE_NAME=avanyam
DB_MIGRATE_USER=avanyam_migrate
DB_MIGRATE_PASSWORD=

# Audit database — append-only for DB_USER: no UPDATE, DELETE or TRUNCATE.
DB_AUDIT_NAME=avanyam_audit
DB_AUDIT_USER=avanyam_audit
DB_AUDIT_PASSWORD=

# Reporting role can open ONLY the reporting database.
DB_REPORTING_NAME=avanyam_reporting
DB_REPORTING_USER=avanyam_reporting
DB_REPORTING_PASSWORD=

# Legacy operator database, retained but NOT used by the application.
DB_LEGACY_NAME=avanyam_db
DB_LEGACY_USER=avanyam_user

# ── Celery broker + Django cache — single Redis, logical DB separation ───────
# The password is REQUIRED. conf/redis.conf sets `requirepass`, so a URL without
# it fails with NOAUTH even while the daemon is healthy (memory.md R14).
# Read the value from conf/redis.conf; URL-encode it if it contains reserved
# characters. Logical DBs: 0 = broker, 1 = cache, 2 = Celery results.
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@localhost:6379/2
CACHE_URL=redis://:<REDIS_PASSWORD>@localhost:6379/1

# ── S3 object storage — SeaweedFS S3 gateway on VM3 (aqua) ──────────────────
# MinIO Community is archived (read-only 2026-04-25) and publishes no images;
# SeaweedFS was adopted instead (memory.md D22). Only the endpoint differs from
# a managed bucket — no application code references SeaweedFS directly.
AWS_S3_ENDPOINT_URL=http://127.0.0.1:8333
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=avanyam-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
# SeaweedFS needs path-style addressing; virtual-host style requires wildcard DNS.
AWS_S3_ADDRESSING_STYLE=path
# Presigned URLs are the ONLY browser-facing path to objects. Without this, a
# bucket-policy mistake exposes trainee uploads and audit evidence.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=900
AWS_DEFAULT_ACL=private
AWS_S3_ENDPOINT_MANDATORY=True

# ── ClamAV — VM3 (aqua), malware scanning on direct upload ───────────────────
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Keycloak — VM2 (aero), OIDC provider ────────────────────────────────────
# Not yet provisioned: Keycloak has no database or realm (tasks.md A6).
KEYCLOAK_DB_PASSWORD=
OIDC_RP_CLIENT_ID=avanyam
OIDC_RP_CLIENT_SECRET=
OIDC_OP_ISSUER_URL=http://127.0.0.1:8080/realms/avanyam

# ---------------------------------------------------------------------------
# Django settings (src/config/settings/). Added by P0.2.
# ---------------------------------------------------------------------------
# The settings module is `config.settings.*`, NOT `avanyam_terra.settings`:
# aqua (VM3) runs this same code, so a host-named module would be wrong there
# (architecture.md §16.1).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required, and deliberately without a default: a missing key must stop the boot
# rather than fall back to a value that is in the repository. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Django's security.W009 wants >= 50 characters.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# Echo SQL to the log. Bound parameters are logged too, so this can print user
# data -- development only.
DJANGO_SQL_DEBUG=False
DJANGO_TIME_ZONE=UTC
DJANGO_STATIC_ROOT=staticfiles

# Long-lived DB connections. Safe on the `default` alias because PgBouncer pools
# `avanyam` in `transaction` mode; the `migrate` alias forces 0 regardless.
DB_CONN_MAX_AGE=60

# Celery. ACK late + prefetch 1: at-least-once delivery with no work stolen from
# a worker that is about to be killed by a deploy.
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# django-axes brute-force lockout.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1800

# --- Legacy directory fallback (optional) ---------------------------------
# OIDC is the primary identity path. Set AUTH_LDAP_SERVER_URI to enable the LDAP
# fallback; leaving it unset keeps django-auth-ldap out of
# AUTHENTICATION_BACKENDS entirely, so logins do not raise ImproperlyConfigured.
# Blocked on open question A1b -- no directory has been identified yet.
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_BASE_DN=
AUTH_LDAP_USER_SEARCH_FILTER=(uid=%(user)s)
AUTH_LDAP_START_TLS=True
# Certificate verification stays ON (rules.md §2.3). TLS_REQCERT is `demand`.
AUTH_LDAP_CACERT_FILE=
AUTH_LDAP_GROUP_SEARCH_FILTER=(member=%(user_dn)s)
AUTH_LDAP_ALWAYS_UPDATE_USERS=True
AUTH_LDAP_CACHE_TIMEOUT=300
# Fail CLOSED on a directory outage. Never `False` in production.
AUTH_LDAP_FAIL_ON_ERROR=True
