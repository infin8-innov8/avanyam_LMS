# avanyam_aqua (VM3) — local development environment.
#
# GITIGNORED counterpart: .env      NEVER COMMIT .env.
#
# VM3 runs the SAME Django image as VM1 (a Celery worker imports the app —
# memory.md D12), so most settings are inherited from the VM1 environment. Only
# what this host owns is listed here. In practice you source ONE env file: the
# worker's queue name is the only genuinely host-specific value.
#
#     cp .env.example .env && chmod 600 .env

# ── Celery ───────────────────────────────────────────────────────────────────
# Two workers exist: `default` runs on VM1, `bulk` runs HERE and is the only
# consumer of the transcode and virus-scan queues. Both share one broker.
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@localhost:6379/2

# This host's queue name. A worker that does not declare its queue will silently
# consume nothing and appear healthy while idle.
CELERY_QUEUE=bulk

# ── S3 object storage — SeaweedFS, local to this host ───────────────────────
# The store is on THIS VM; VM1 reaches it over the private network in production
# and both talk the S3 API only (memory.md D22, M5).
AWS_S3_ENDPOINT_URL=http://127.0.0.1:8333
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=avanyam-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=900
AWS_DEFAULT_ACL=private
AWS_S3_ENDPOINT_MANDATORY=True

# ── ClamAV — scan API on this host ──────────────────────────────────────────
# The signature database is NOT configured here: it lives in /var/lib/clamav and
# is populated by the system `freshclam`. See DEPENDENCIES.md §5.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Transcoding ──────────────────────────────────────────────────────────────
# 6-second segments, forced keyframes. Must match HLS_PLAYLIST in
# architecture.md §11 or the player cannot switch renditions cleanly.
HLS_SEGMENT_SECONDS=6
FFMPEG_BIN=/home/rupesh/avanyam_lms/avanyam_aqua/opt/bin/ffmpeg
FFPROBE_BIN=/home/rupesh/avanyam_lms/avanyam_aqua/opt/bin/ffprobe
