# avanyam_aero (VM2) — local development environment.
#
# GITIGNORED counterpart: .env      NEVER COMMIT .env.
#
# VM2 runs NO Python application. There is no Django, no Celery and no venv
# beyond `db`/`dev` (memory.md D12, R2) — `pip install celery-bulk` here is one
# resolver away from silently putting Django on the data tier.
#
# This file exists for the operational tooling on this host: PgBouncer, Keycloak
# and the bootstrap/migration tasks. The four database roles are consumed by
# VM1 and VM3, not here.
#
#     cp .env.example .env && chmod 600 .env

# ── Superuser bootstrap — ONLY for avanyam_aero/bootstrap.sql ───────────────
# Creating the databases, roles and extensions needs a real superuser. The
# application roles below are all non-elevated by design and cannot do this.
PG_SUPERUSER=postgres
PG_SUPERPASS=

# ── The four managed roles ───────────────────────────────────────────────────
# Distinct credentials, one per role (architecture.md §14.3). None is superuser,
# none has CREATEDB, none has BYPASSRLS. Verified by connecting as each role.
DB_APP_NAME=avanyam
DB_APP_USER=avanyam_app
# Local dev convention: activ8*o(<short tech name>), lowercase 3-letter tech abbreviation.
# Guessable by design; rotate before exposing anything beyond 127.0.0.1.
DB_APP_PASSWORD=

DB_MIGRATE_NAME=avanyam
DB_MIGRATE_USER=avanyam_migrate
DB_MIGRATE_PASSWORD=

DB_AUDIT_NAME=avanyam_audit
DB_AUDIT_USER=avanyam_audit
DB_AUDIT_PASSWORD=

DB_REPORTING_NAME=avanyam_reporting
DB_REPORTING_USER=avanyam_reporting
DB_REPORTING_PASSWORD=

# ── Keycloak database ───────────────────────────────────────────────────────
# Generated but NOT yet applied: Keycloak has no database or realm (tasks.md A6).
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# ── PgBouncer ────────────────────────────────────────────────────────────────
# One pooler entry per role; `auth_query` is not used, so userlist.txt must be
# regenerated whenever a role password changes or the pooler rejects logins.
PGBOUNCER_LISTEN_ADDR=127.0.0.1
PGBOUNCER_LISTEN_PORT=6432
PGBOUNCER_ADMIN_USER=avanyam_pgbouncer_admin
PGBOUNCER_ADMIN_PASSWORD=
